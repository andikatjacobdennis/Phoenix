{
  "//": [
    "A complete example of adopting Phoenix for another company.",
    "Copy this over src/Phoenix/appsettings.json (or pass it with --config) and change the values.",
    "Nothing in Phoenix's source code needs to be edited to rebrand or retarget it."
  ],

  "Phoenix": {
    "Company": {
      "Name": "Contoso Ltd",
      "SupportEmail": "servicedesk@contoso.example",
      "SupportUrl": "https://intranet.contoso.example/servicedesk",
      "SupportText": "Need help? Call the service desk on x1234 and quote the reference above."
    },

    "Product": {
      "Name": "Contoso Warehouse",
      "Slug": "ContosoWarehouse"
    },

    "Branding": {
      "ConsoleTitle": "Contoso Warehouse Setup",
      "WelcomeText": "Contoso Warehouse",
      "AccentColor": "#0078d4",
      "GreetUserByName": true
    },

    "GitHub": {
      "Owner": "contoso",
      "Repository": "warehouse-releases",
      "TokenEnvironmentVariable": "CONTOSO_RELEASE_TOKEN",
      "MaxReleasesToInspect": 20
    },

    "Application": {
      "Id": "contoso-warehouse",
      "Name": "Contoso Warehouse",
      "Url": "http://localhost:8080",
      "EnvironmentVariables": {
        "Warehouse__Region": "emea"
      },
      "ShutdownTimeoutSeconds": 30,
      "ReuseRunningInstance": true
    },

    "Updates": {
      "Channel": "Production",
      "Policy": "Automatic",
      "RemoteFallbackCount": 2,
      "ConfirmBeforeUpdate": false
    },

    "Directories": {
      "//": "Per-user by default. Use %ProgramData% for a machine-wide installation (needs write access).",
      "Root": "%LOCALAPPDATA%\\Contoso\\{ProductSlug}"
    },

    "HealthCheck": {
      "Path": "/health/ready",
      "MaxAttempts": 60,
      "OverallTimeoutSeconds": 120
    },

    "Recovery": {
      "EnableAutomaticRollback": true,
      "KeepVersions": 3,
      "BackupRetention": 2
    },

    "Security": {
      "RequireHttps": true,
      "RequireChecksum": true,
      "//RequireSignature": "Turn on once your packages are Authenticode signed.",
      "RequireSignature": false,
      "AllowedCertificateThumbprints": [],
      "AllowedDownloadHosts": [
        "github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "api.github.com"
      ]
    },

    "Browser": {
      "LaunchOnSuccess": true
    },

    "Prerequisites": {
      "Enabled": true,
      "InstallMissing": true,
      "Required": [
        {
          "Id": "aspnetcore-runtime",
          "DisplayName": ".NET Runtime",
          "Mandatory": true,
          "VersionRange": "[9.0,11.0)",
          "Detection": {
            "Strategy": "DotNetRuntime",
            "RuntimeName": "Microsoft.AspNetCore.App"
          }
        }
      ]
    }
  }
}
