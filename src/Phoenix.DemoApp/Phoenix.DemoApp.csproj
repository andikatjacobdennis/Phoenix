<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Phoenix.DemoApp</RootNamespace>
    <AssemblyName>Phoenix.DemoApp</AssemblyName>
    <UserSecretsId>phoenix-demoapp</UserSecretsId>

    <!-- Published framework-dependent: the ASP.NET Core runtime is the prerequisite Phoenix installs. -->
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
