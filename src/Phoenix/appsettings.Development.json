{
  "Phoenix": {
    "Branding": {
      "WelcomeText": "Example Company Setup (Development)"
    },

    "Updates": {
      "Channel": "Development",
      "Policy": "Automatic",
      "RemoteFallbackCount": 2
    },

    "Directories": {
      "Root": "%LOCALAPPDATA%\\Phoenix\\dev\\{ProductSlug}"
    },

    "Application": {
      "Url": "http://localhost:5081"
    },

    "HealthCheck": {
      "MaxAttempts": 20,
      "OverallTimeoutSeconds": 45
    },

    "Testing": {
      "SimulateFault": "None",
      "SimulatePrerequisiteInstalls": true,
      "AllowBrowserLaunch": true
    }
  }
}
