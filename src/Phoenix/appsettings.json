{
  "Phoenix": {
    "Company": {
      "Name": "Example Company",
      "SupportEmail": "support@example.com",
      "SupportText": "Need help? Contact the IT service desk and quote the reference above."
    },

    "Product": {
      "Name": "Example Application",
      "Slug": "ExampleApp"
    },

    "Branding": {
      "ConsoleTitle": "Phoenix",
      "WelcomeText": "Example Company Setup",
      "AccentColor": "deepskyblue1",
      "GreetUserByName": true
    },

    "GitHub": {
      "Owner": "andikatjacobdennis",
      "Repository": "Phoenix",
      "ApiBaseUrl": "https://api.github.com",
      "TokenEnvironmentVariable": "PHOENIX_GITHUB_TOKEN",
      "IncludeDrafts": false,
      "MaxReleasesToInspect": 30
    },

    "Application": {
      "Id": "phoenix-demoapp",
      "Name": "Example Application",
      "Url": "http://localhost:5080",
      "AdditionalArguments": [],
      "EnvironmentVariables": {},
      "ShutdownTimeoutSeconds": 20,
      "StartupGraceSeconds": 2,
      "ReuseRunningInstance": true
    },

    "Updates": {
      "Channel": "Production",
      "Policy": "Automatic",
      "RemoteFallbackCount": 2,
      "AllowDowngrade": false,
      "ConfirmBeforeUpdate": false
    },

    "Directories": {
      "Root": "%LOCALAPPDATA%\\Phoenix\\{ProductSlug}"
    },

    "HealthCheck": {
      "Enabled": true,
      "Path": "/health",
      "RequestTimeoutSeconds": 5,
      "RetryIntervalMilliseconds": 1000,
      "MaxAttempts": 40,
      "OverallTimeoutSeconds": 90,
      "ExpectedStatusCodes": [ 200 ]
    },

    "Recovery": {
      "EnableAutomaticRollback": true,
      "KeepVersions": 3,
      "BackupRetention": 2,
      "RequireHealthCheckForKnownGood": true
    },

    "Network": {
      "RequestTimeoutSeconds": 30,
      "DownloadTimeoutMinutes": 30,
      "MaxRetries": 3,
      "RetryBaseDelayMilliseconds": 500
    },

    "Security": {
      "RequireHttps": true,
      "RequireChecksum": true,
      "RequireSignature": false,
      "AllowedCertificateThumbprints": [],
      "AllowedDownloadHosts": [
        "github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "api.github.com"
      ],
      "MaxPackageSizeBytes": 2147483648,
      "MaxExtractedSizeBytes": 8589934592,
      "MaxArchiveEntries": 200000,
      "DiskSpaceMarginBytes": 536870912
    },

    "Browser": {
      "LaunchOnSuccess": true
    },

    "Prerequisites": {
      "Enabled": true,
      "InstallMissing": true,
      "Required": [
        {
          "Id": "aspnetcore-runtime",
          "DisplayName": ".NET Runtime",
          "Mandatory": true,
          "VersionRange": "[9.0,11.0)",
          "Architecture": "any",
          "Detection": {
            "Strategy": "DotNetRuntime",
            "RuntimeName": "Microsoft.AspNetCore.App"
          }
        }
      ]
    }
  }
}
