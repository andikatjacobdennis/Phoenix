<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net9.0-windows gives direct access to the registry and file-version APIs that
      prerequisite detection needs, without pulling in compatibility packages.
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Phoenix.Infrastructure</RootNamespace>
    <AssemblyName>Phoenix.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phoenix.Core\Phoenix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phoenix.Tests" />
    <InternalsVisibleTo Include="Phoenix.IntegrationTests" />
  </ItemGroup>

</Project>
