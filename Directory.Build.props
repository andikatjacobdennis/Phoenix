<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8618;CS4014</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Suppressed by design:
        CA1848/CA1873 - LoggerMessage source generators are overkill for a bootstrapper.
        CA1031        - Phoenix deliberately catches broadly and converts to PhoenixError.
        CA2007        - not a library with a synchronization context to flow.
        CA1000/CA1716 - Result<T>.Success and 'error'/'next' parameter names are clearer than the alternatives.
        CA1822        - public API surface stays instance-based for testability and DI.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1859;CA1826;CA1838;CA1305;CA1307;CA1031;CA2007;CA1510;CA1863;CA1861;CA1000;CA1716;CA1822;CA1002;CA2227;CA1819</NoWarn>
  </PropertyGroup>

  <!--
    Versioning is owned by CI. Local builds fall back to a development version.
    CI passes: -p:PhoenixVersion=1.4.0 (or 1.4.0-qa.3)
  -->
  <PropertyGroup>
    <PhoenixVersion Condition="'$(PhoenixVersion)' == ''">0.1.0-dev</PhoenixVersion>
    <Version>$(PhoenixVersion)</Version>
    <VersionPrefix>$(PhoenixVersion.Split('-')[0])</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(PhoenixVersion)</InformationalVersion>
    <Company>$(PhoenixCompany)</Company>
    <Company Condition="'$(Company)' == ''">Phoenix</Company>
    <Product>Phoenix</Product>
    <Copyright>Copyright (c) Phoenix contributors</Copyright>
  </PropertyGroup>

</Project>
